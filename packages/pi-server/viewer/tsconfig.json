{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
		"allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom", "vitest/globals"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src/viewer-types.ts"]
}
